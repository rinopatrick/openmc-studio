{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMC Studio",
  "version": "0.1.0",
  "identifier": "studio.openmc.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMC Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "appimage", "deb"],
    "icon": ["icons/icon.png"]
  }
}
